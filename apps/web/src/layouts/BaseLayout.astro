---
/**
 * Base layout for every page.
 *
 * Inputs:
 *   title         — used in <title> with brand suffix
 *   description   — meta description; we fall back to brand tagline
 *   alternates    — locale → href mapping for hreflang + locale switcher
 *   pageT         — `t(key)` (Astro can't pass closures across components, so
 *                   we re-derive it in components by reading Astro.locals)
 *
 * Behaviour:
 *   - sets html[lang]/html[dir] from `Astro.currentLocale`
 *   - injects design tokens, fonts and components.css via global.css
 *   - renders skip-link + accessible header/footer
 *   - sets canonical + hreflang from `alternates`
 */
import '~/styles/global.css';
import { buildT } from '~/lib/i18n';
import { type AppLocale, DEFAULT_LOCALE, dirOf } from '~/lib/locales';
import { localeHrefsFor, routes } from '~/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** Mapping locale → href for the equivalent page. Default = same path on each locale. */
  alternates?: Record<AppLocale, string>;
  /** OpenGraph image URL (absolute). */
  ogImage?: string;
  /** Optional JSON-LD blocks (already-stringified). */
  schemas?: ReadonlyArray<Record<string, unknown>>;
}

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as AppLocale;
const t = buildT(locale);
const dir = dirOf(locale);
const alternates: Record<AppLocale, string> =
  Astro.props.alternates ?? localeHrefsFor((l) => routes.home(l));

const baseUrl = (import.meta.env.PUBLIC_BASE_URL ?? 'https://uzmdroguzbak.com').replace(/\/$/, '');
const canonical = `${baseUrl}${Astro.url.pathname}`;
const fullTitle = `${Astro.props.title} — ${t('brand.doctor')}`;
const description = Astro.props.description ?? t('brand.tagline');
const ogImage = Astro.props.ogImage ?? `${baseUrl}/og/default.jpg`;

/**
 * Soft-launch banner. Appears on AR/FR/ES when SOFT_LAUNCH=1 (CF Pages
 * env var). The banner is removed by the owner after the medical translator
 * has signed off — see LAUNCH-CHECKLIST.md group B and the scheduled
 * reminder agent. Search engines still see the page (no noindex) but the
 * patient sees a clear "auto-translated, review pending" notice.
 *
 * The TR copy is the master string; per-locale text below is one-time
 * placeholder content vetted in TR + EN by the doctor on Phase 2 sign-off.
 */
const softLaunchOn = import.meta.env.SOFT_LAUNCH === '1';
const showSoftLaunchBanner = softLaunchOn && (locale === 'ar' || locale === 'fr' || locale === 'es');
const softLaunchCopy: Record<AppLocale, string> = {
  tr: 'Bu sayfa otomatik çevrildi; tıbbi inceleme süreci devam ediyor.',
  ar: 'تُرجمت هذه الصفحة آليًا؛ المراجعة الطبية جارية.',
  en: 'This page was machine-translated; medical review is in progress.',
  fr: 'Cette page est une traduction automatique ; la relecture médicale est en cours.',
  es: 'Esta página es una traducción automática; la revisión médica está en curso.',
};
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang */}
    {Object.entries(alternates).map(([loc, href]) => (
      <link rel="alternate" hreflang={loc} href={`${baseUrl}${href}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${alternates.tr}`} />

    {/* OpenGraph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Favicons */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    {/* JSON-LD blocks */}
    {Astro.props.schemas?.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-grain">
    <a class="drb-skiplink" href="#main">{t('common.skipToContent')}</a>
    {showSoftLaunchBanner && (
      <div class="soft-launch-banner" role="status" aria-live="polite">
        <p>{softLaunchCopy[locale]}</p>
      </div>
    )}
    <div class="app-shell">
      <Header alternates={alternates} />
      <main id="main" class="app-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
<style is:global>
  /* Make sure the grain overlay sits behind page content */
  .app-shell { position: relative; z-index: 1; }
  .soft-launch-banner {
    background: var(--color-warning);
    color: #fff;
    padding: var(--space-2) var(--space-5);
    text-align: center;
    font-size: var(--type-meta);
    line-height: 1.4;
  }
  .soft-launch-banner p { margin: 0; max-width: none; }
</style>
