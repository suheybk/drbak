---
import BookingFlow from '~/islands/BookingFlow';
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { Me } from '~/lib/auth-guard';
import { buildT, loadDict } from '~/lib/i18n';
import type { AppLocale } from '~/lib/locales';
import { localeHrefsFor, routes } from '~/lib/routes';

interface Props {
  locale: AppLocale;
  /** Authenticated user — page entry must auth-guard before rendering this view. */
  me: Me;
  presetServiceSlug?: string | undefined;
}

const { locale, me, presetServiceSlug } = Astro.props;
const t = buildT(locale);
const alternates = localeHrefsFor((l) => routes.book(l));
const dict = loadDict(locale);

const consentVersion =
  (import.meta.env as never as { CONSENT_DOCUMENT_VERSION?: string }).CONSENT_DOCUMENT_VERSION ??
  'v1.2026-04';
---
<BaseLayout title={t('booking.title')} description={t('home.heroLead')} alternates={alternates}>
  <header class="app-section" style="margin-block-start: 0;">
    <h1>{t('booking.title')}</h1>
  </header>
  {!me.emailVerified ? (
    <div class="drb-banner drb-banner--warning" style="margin-block-end: var(--space-6);">
      <p style="margin: 0;">{t('errors.EMAIL_NOT_VERIFIED')}</p>
    </div>
  ) : null}
  <BookingFlow
    client:load
    locale={locale}
    dict={dict}
    consentDocumentVersion={consentVersion}
    presetServiceSlug={presetServiceSlug}
  />
</BaseLayout>
