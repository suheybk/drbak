---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { buildT, loadDict } from '~/lib/i18n';
import { routes, localeHrefsFor } from '~/lib/routes';
import type { AppLocale } from '~/lib/locales';
import AuthForm from '~/islands/AuthForm';

interface Props { locale: AppLocale; next?: string }
const { locale, next } = Astro.props;
const t = buildT(locale);
const alternates = localeHrefsFor((l) => routes.login(l));
const dict = loadDict(locale);
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.uzmdroguzbak.com/api/v1';
const oauthBegin = `${apiBase}/auth/oauth/google/begin?locale=${locale}${next ? `&redirectAfter=${encodeURIComponent(next)}` : ''}`;
const consentVersion = (import.meta.env as never as { CONSENT_DOCUMENT_VERSION?: string }).CONSENT_DOCUMENT_VERSION ?? 'v1.2026-04';
---
<BaseLayout title={t('auth.loginTitle')} description={t('auth.loginTitle')} alternates={alternates}>
  <article class="app-prose" style="max-width: 460px;">
    <h1>{t('auth.loginTitle')}</h1>
    <AuthForm
      client:load
      locale={locale}
      dict={dict}
      mode="login"
      next={next}
      consentDocumentVersion={consentVersion}
      oauthBeginPath={oauthBegin}
    />
    <p style="margin-block-start: var(--space-6);">
      {t('auth.noAccountYet')} <a href={routes.register(locale)}>{t('auth.registerTitle')}</a>
    </p>
    <p>
      <a href={routes.resetPassword(locale)}>{t('auth.forgotPassword')}</a>
    </p>
  </article>
</BaseLayout>
