---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { buildT } from '~/lib/i18n';
import { routes, localeHrefsFor } from '~/lib/routes';
import { serverFetch } from '~/lib/api';
import type { AppLocale } from '~/lib/locales';

interface Props { locale: AppLocale; request: Request }
const { locale, request } = Astro.props;
const t = buildT(locale);
const alternates = localeHrefsFor((l) => routes.blog(l));

type Item = {
  id: string;
  type: 'blog';
  slug: string;
  slugLocalised: string;
  title: string;
  leadParagraph: string | null;
  publishedAt: string | null;
  readingMinutes: number | null;
};
const r = await serverFetch<{ items: Item[] }>(request, `/public/content?type=blog&locale=${locale}`);
const items = r.ok ? r.value.items : [];
---
<BaseLayout title={t('blog.title')} description={t('blog.lead')} alternates={alternates}>
  <header class="app-section" style="margin-block-start: 0;">
    <h1>{t('blog.title')}</h1>
    <p class="hero__lead">{t('blog.lead')}</p>
  </header>
  {items.length === 0 ? (
    <p style="color: var(--color-ink-subtle);">—</p>
  ) : (
    <div class="card-grid">
      {items.map((p) => (
        <a class="card" href={routes.blogPost(locale, p.slug)}>
          <p class="card__title">{p.title}</p>
          {p.leadParagraph ? <p class="card__lead">{p.leadParagraph}</p> : null}
          <div class="card__meta">
            {p.readingMinutes ? (
              <span class="digit-western" dir="ltr">{t('blog.minutesRead', { minutes: p.readingMinutes })}</span>
            ) : null}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
