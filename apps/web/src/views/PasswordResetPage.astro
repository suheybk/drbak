---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { buildT, loadDict } from '~/lib/i18n';
import { routes, localeHrefsFor } from '~/lib/routes';
import type { AppLocale } from '~/lib/locales';
import PasswordResetForm from '~/islands/PasswordResetForm';

interface Props { locale: AppLocale; token?: string }
const { locale, token } = Astro.props;
const t = buildT(locale);
const alternates = localeHrefsFor((l) => routes.resetPassword(l));
const dict = loadDict(locale);
const mode = token ? 'confirm' : 'request';
---
<BaseLayout title={t('auth.resetTitle')} description={t('auth.resetLead')} alternates={alternates}>
  <article class="app-prose" style="max-width: 460px;">
    <h1>{t('auth.resetTitle')}</h1>
    <p>{t('auth.resetLead')}</p>
    <PasswordResetForm client:load locale={locale} dict={dict} mode={mode} token={token} />
  </article>
</BaseLayout>
