---
import { type AppLocale, DEFAULT_LOCALE } from '~/lib/locales';
import PasswordResetPage from '~/views/PasswordResetPage.astro';
const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as AppLocale;
const token = Astro.url.searchParams.get('token') ?? undefined;
---
<PasswordResetPage locale={locale} token={token} />
