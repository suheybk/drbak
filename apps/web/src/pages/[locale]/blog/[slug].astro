---
import { type AppLocale, DEFAULT_LOCALE } from '~/lib/locales';
import BlogPostPage from '~/views/BlogPostPage.astro';
const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as AppLocale;
const slug = Astro.params.slug as string;
---
<BlogPostPage locale={locale} slug={slug} request={Astro.request} />
