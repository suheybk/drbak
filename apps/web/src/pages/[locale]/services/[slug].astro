---
import { type AppLocale, DEFAULT_LOCALE, LOCALES } from '~/lib/locales';

const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as AppLocale;
const slug = Astro.params.slug as string;
if (!LOCALES.includes(locale)) return Astro.redirect('/404');
---
<ServiceDetailPage locale={locale} slug={slug} request={Astro.request} />
