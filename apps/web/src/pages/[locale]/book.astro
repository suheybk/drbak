---
import { type AppLocale, DEFAULT_LOCALE } from '~/lib/locales';
const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as AppLocale;
const presetServiceSlug = (Astro.url.searchParams.get('service') ?? undefined) as
  | string
  | undefined;
---
<BookingPage locale={locale} request={Astro.request} presetServiceSlug={presetServiceSlug} />
