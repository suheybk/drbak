---
import { DoctorNote } from '@dr-bak/ui';
import AboutPreviewSection from '~/components/AboutPreviewSection.astro';
import EvdeHizmetCallout from '~/components/EvdeHizmetCallout.astro';
import HizliRandevuSection from '~/components/HizliRandevuSection.astro';
import NumberedServicesSection from '~/components/NumberedServicesSection.astro';
import StatsStrip from '~/components/StatsStrip.astro';
import TeamSection from '~/components/TeamSection.astro';
import TestimonialsStrip from '~/components/TestimonialsStrip.astro';
import TrustBadges from '~/components/TrustBadges.astro';
import YouTubeEmbedsSection from '~/components/YouTubeEmbedsSection.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { buildT } from '~/lib/i18n';
import { type AppLocale, DEFAULT_LOCALE } from '~/lib/locales';
import { localeHrefsFor, routes } from '~/lib/routes';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as AppLocale;
const t = buildT(locale);
const alternates = localeHrefsFor((l) => routes.home(l));

const physicianSchema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: t('brand.doctor'),
  medicalSpecialty: ['Neurology', 'Pain Medicine'],
  worksFor: {
    '@type': 'MedicalClinic',
    name: t('brand.clinic'),
    address: t('about.address'),
  },
  email: import.meta.env.CONTACT_EMAIL,
  telephone: import.meta.env.CONTACT_PHONE_E164,
  url: import.meta.env.PUBLIC_BASE_URL,
};
---
<BaseLayout
  title={t('home.heroTitle')}
  description={t('home.heroLead')}
  alternates={alternates}
  schemas={[physicianSchema]}
>
  <section class="hero">
    <h1 class="hero__title">{t('home.heroTitle')}</h1>
    <p class="hero__lead">{t('home.heroLead')}</p>
    <div class="hero__ctas">
      <a class="drb-btn drb-btn--primary drb-btn--lg" href={routes.book(locale)}>
        {t('home.heroCta')}
      </a>
      <a class="drb-btn drb-btn--secondary drb-btn--lg" href={routes.services(locale)}>
        {t('home.heroSecondaryCta')}
      </a>
    </div>
  </section>

  <AboutPreviewSection />

  <StatsStrip />

  <NumberedServicesSection />

  <EvdeHizmetCallout />

  <TestimonialsStrip request={Astro.request} />

  <YouTubeEmbedsSection />

  <TeamSection />

  <HizliRandevuSection />

  <DoctorNote
    label={t('blog.doctorNoteLabel')}
    doctorName={t('brand.doctor')}
    doctorTitle={t('brand.doctorTitle')}
  >
    <p style="margin: 0;">
      {/* placeholder first-party voice — replace with real quote from owner */}
      {locale === 'tr'
        ? 'Hastalarımı dinleyerek başlamayı seviyorum. Ağrı çoğu zaman yalnız bir deneyimdir; teşhis koymadan önce o deneyimi anlamak gerekir.'
        : locale === 'ar'
          ? 'أبدأ دائمًا بالإصغاء. الألم تجربة غالبًا ما تكون موحشة، وفهم تلك التجربة أهم من السرعة في التشخيص.'
          : 'I like to start by listening. Pain is often a lonely experience; understanding that experience matters more than rushing to a diagnosis.'}
    </p>
  </DoctorNote>

  <TrustBadges />
</BaseLayout>
