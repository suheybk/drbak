{
  "name": "drbak",
  "version": "0.1.0",
  "private": true,
  "description": "Uzm. Dr. Oğuz Bak — Pain & Chronic Illnesses Clinic — website + booking platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @dr-bak/api dev",
    "dev:web": "pnpm --filter @dr-bak/web dev",
    "dev": "pnpm -r --parallel --stream dev",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter @dr-bak/web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @dr-bak/api db:generate",
    "db:migrate": "pnpm --filter @dr-bak/api db:migrate",
    "db:studio": "pnpm --filter @dr-bak/api db:studio",
    "deploy:staging": "pnpm -r deploy:staging",
    "deploy:prod": "pnpm -r deploy:prod"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "25.6.0",
    "pg": "^8.20.0",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "zod-to-json-schema": "3.23.5"
    }
  }
}
